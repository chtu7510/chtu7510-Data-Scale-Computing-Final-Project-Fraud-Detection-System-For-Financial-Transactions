FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Default to TCP producer; override command for gRPC/server/gateway roles via docker-compose or run args.
CMD ["python", "Generators/tcp_client.py"]
